{{/* Generate only example sections that exist in the current language's content tree. */}}
{{ .EnableAllLanguages }}
{{ $root := path.Join (.Site.Params.bookkit.contentRoot | default "content") "examples" }}
{{ if fileExists $root }}
  {{ range readDir $root }}
    {{ if .IsDir }}
      {{ $book := .Name }}
      {{ if not (fileExists (path.Join $root $book "_index.md")) }}
        {{ $.AddPage (dict "kind" "section" "path" $book "title" (i18n "bookkit_examples_title" (dict "Book" $book))) }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
